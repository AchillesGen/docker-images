diff --git a/src/nuis/record/plugins/NUISANCE2Record.cxx b/src/nuis/record/plugins/NUISANCE2Record.cxx
index 796183d..f6d9e2b 100644
--- a/src/nuis/record/plugins/NUISANCE2Record.cxx
+++ b/src/nuis/record/plugins/NUISANCE2Record.cxx
@@ -148,6 +148,38 @@ struct NUISANCE2Analysis : public IAnalysis {
     }
     return covmat;
   }
+
+  // Samples can keep state from the events they select, so call this after the
+  // events have been through get_selection and get_projections.
+  Eigen::VectorXd convert_event_rates(Eigen::VectorXd const &event_rates,
+                                      double scale_factor) const {
+    auto meas1d = std::dynamic_pointer_cast<Measurement1D>(measurement);
+    if (!meas1d) {
+      throw NUISANCE2InvalidMeasurementType()
+          << "convert_event_rates only supports 1D measurements";
+    }
+
+    meas1d->ResetAll();
+    meas1d->SetScaleFactor(scale_factor);
+
+    TH1D *mc = meas1d->GetMCHistogram();
+    if (event_rates.size() != mc->GetNbinsX()) {
+      throw NUISANCE2InvalidMeasurementType()
+          << "convert_event_rates passed " << event_rates.size()
+          << " bins, but the measurement has " << mc->GetNbinsX();
+    }
+    for (int i = 0; i < mc->GetNbinsX(); ++i) {
+      mc->SetBinContent(i + 1, event_rates(i));
+    }
+
+    meas1d->ConvertEventRates();
+
+    Eigen::VectorXd converted(mc->GetNbinsX());
+    for (int i = 0; i < mc->GetNbinsX(); ++i) {
+      converted(i) = mc->GetBinContent(i + 1);
+    }
+    return converted;
+  }
 };
 
